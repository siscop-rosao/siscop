rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Permite leitura e escrita dos associados e carteirinhas
    match /cards/{cardId} {
      allow read, write: if true;
    }

    // Permite leitura e agendamento dos quiosques de churrasqueira
    match /reservations/{reservationId} {
      allow read, write: if true;
    }

    // Procedimentos Operacionais Padrão (POP)
    match /popProcedures/{popId} {
      allow read, write: if true;
    }

    // Trilha de Auditoria: permite leitura e gravação de novos registros; sem deleção
    match /auditLogs/{logId} {
      allow read, create: if true;
      allow update, delete: if false;
    }

    // Usuários e operadores do sistema (Setup de Acesso)
    match /users/{userId} {
      allow read, write: if true;
    }

    // Configurações da plataforma (Identidade Visual, Brasão, Banner, Títulos)
    match /settings/{settingId} {
      allow read, write: if true;
    }

    // Layout de impressão da carteirinha
    match /layoutConfig/{layoutId} {
      allow read, write: if true;
    }

    // Status e verificação de conectividade em tempo real
    match /systemStatus/{statusId} {
      allow read, write: if true;
    }

    // Regra geral de segurança para coleções operacionais do SISCOP
    match /{document=**} {
      allow read, write: if true;
    }
  }
}
